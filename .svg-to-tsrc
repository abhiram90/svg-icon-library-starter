{
    "conversionType": "files",
    "srcFiles": [
      "./svg-icons/**/*.svg"
    ],
    "outputDirectory": "./dist/icons",
    "interfaceName": "SAIcons",
    "typeName": "saIcons",
    "prefix": "saIcons",
    "generateType": true,
    "exportCompleteIconSet": true,
    "optimizeForLazyLoading": true,
    "modelFileName": "sa-icons.model.ts",
    "compileSources": true
}
